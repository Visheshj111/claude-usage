{
  "manifest_version": 3,
  "name": "Claude Usage Tracker - Stats & Export Chat",
  "version": "1.4.0",
  "description": "Track your Claude.ai usage, messages, tokens, and conversations. Export your message. Not affiliated with Anthropic.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "activeTab",
    "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://api.anthropic.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/inpage/inpage.css",
        "dist/watcher.js",
        "dist/dashboard/dashboard.html",
        "dist/dashboard/dashboard.css",
        "dist/dashboard/dashboard.js",
        "dist/dashboard/iconify-icon.min.js",
        "dist/theme-boot.js"
      ],
      "matches": [
        "https://claude.ai/*"
      ]
    }
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "dist/injector.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "dist/watcher.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "css": [
        "dist/inpage/inpage.css"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "dist/popup/popup.html",
    "default_title": "Claude Usage Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "dist/options/options.html",
    "open_in_tab": true
  }
}